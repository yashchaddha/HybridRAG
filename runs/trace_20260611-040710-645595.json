  "sql_attempts": [
    {
      "try": 1,
      "sql": "SELECT GROUP_CONCAT(DISTINCT c.name) AS companies, p.warranty_years FROM products p JOIN order_items oi ON p.id = oi.product_id JOIN orders o ON oi.order_id = o.id JOIN customers c ON o.customer_id = c.id WHERE p.id = 1 LIMIT 50",
      "rows": 1,
      "ok": true
    }
