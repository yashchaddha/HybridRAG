# ─── Hybrid Retrieval POC — example environment file ────────────────
# Copy to `.env` and adjust. All values are optional; sensible defaults
# live in src/hybrid_rag/config.py. With no OPENAI_API_KEY the whole
# pipeline runs offline and deterministically.

# --- LLM (optional) -------------------------------------------------
# Provide an OpenAI key to enable the LLM routing/synthesis path.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024

# --- Retrieval tunables ---------------------------------------------
DOC_TOP_K=5
DOC_CANDIDATES=10
PER_DOC_CAP=3
